{
  "name": "veneko-cli",
  "version": "1.0.1",
  "description": "CLI personal para andamiar proyectos y correr herramientas con IA desde la terminal",
  "type": "module",
  "license": "MIT",
  "author": "Christian Veneko",
  "homepage": "https://github.com/ChristianVeneko/veneko-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianVeneko/veneko-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ChristianVeneko/veneko-cli/issues"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "generator",
    "hexagonal-architecture",
    "markitdown",
    "yt-dlp"
  ],
  "bin": {
    "veneko": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('src/templates','dist/templates',{recursive:true})\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "link": "npm link"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@napi-rs/canvas": "^1.0.3",
    "commander": "^15.0.0",
    "ejs": "^3.1.10",
    "pdfjs-dist": "^6.2.108",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
